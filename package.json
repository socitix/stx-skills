{
  "name": "stx-skills",
  "version": "1.10.4",
  "description": "Organization-wide Claude Code skills collection",
  "main": "dist/cli/install.js",
  "bin": {
    "stx-skills": "./dist/cli/install.js",
    "stx-checkin": "./dist/skills/stx-checkin.js",
    "stx-pr-merge": "./dist/skills/stx-pr-merge.js",
    "stx-version-bump": "./dist/skills/stx-version-bump.js",
    "stx-image": "./dist/skills/stx-image.js",
    "stx-worktree-report": "./dist/skills/stx-worktree-report.js",
    "stx-generate-help": "./dist/cli/generate-help.js",
    "stx-sync-versions": "./dist/cli/sync-versions.js"
  },
  "scripts": {
    "build": "tsc && node dist/cli/sync-versions.js && node dist/cli/generate-help.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "check-docs": "tsc && node dist/cli/sync-versions.js --check && node dist/cli/generate-help.js --check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "skills",
    "agents",
    "git",
    "pr",
    "workflow",
    "images",
    "automation",
    "report",
    "magazine",
    "html",
    "worktree"
  ],
  "author": "STX",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    ".claude/skills",
    ".claude/agents",
    "AGENTS.md"
  ]
}
